{
    "geode": "4.10.2",
    "gd": {
        "win": "2.2074",
        "android": "2.2074"
    },
    "id": "yourname.timerewind",
    "name": "Time Rewind",
    "version": "v1.0.0",
    "developer": "YourName",
    "description": "Rewind time when you die instead of restarting! Limited charges per attempt.",
    "tags": ["gameplay", "enhancement", "utility"],
    "settings": {
        "enabled": {
            "name": "Enable Time Rewind",
            "description": "Toggle the time rewind feature",
            "type": "bool",
            "default": true
        },
        "max-charges": {
            "name": "Max Rewind Charges",
            "description": "Number of rewinds available per attempt",
            "type": "int",
            "default": 3,
            "min": 1,
            "max": 10
        },
        "rewind-duration": {
            "name": "Rewind Duration (seconds)",
            "description": "How many seconds to rewind",
            "type": "float",
            "default": 3.0,
            "min": 1.0,
            "max": 10.0
        },
        "rewind-speed": {
            "name": "Rewind Speed",
            "description": "Speed multiplier for rewind animation",
            "type": "float",
            "default": 2.0,
            "min": 1.0,
            "max": 5.0
        },
        "visual-effects": {
            "name": "Visual Effects",
            "description": "Enable VHS/glitch effects during rewind",
            "type": "bool",
            "default": true
        },
        "audio-sync": {
            "name": "Audio Sync",
            "description": "Sync music position during rewind",
            "type": "bool",
            "default": true
        }
    },
    "dependencies": [],
    "resources": {
        "spritesheets": {}
    }
}

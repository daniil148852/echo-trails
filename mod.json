{
    "geode": "4.10.2",
    "gd": {
        "android": "2.2074",
        "win": "2.2074",
        "mac": "2.2074"
    },
    "id": "yourname.ghost-replay",
    "name": "Ghost Replay",
    "version": "v1.0.0",
    "developer": "YourName",
    "description": "Показывает призрак твоей лучшей попытки во время игры. Соревнуйся сам с собой!",
    "repository": "https://github.com/yourname/ghost-replay",
    "settings": {
        "enabled": {
            "name": "Включить Ghost Replay",
            "description": "Вкл/выкл мод",
            "type": "bool",
            "default": true
        },
        "opacity": {
            "name": "Прозрачность призрака",
            "description": "Насколько виден призрак (0-100%)",
            "type": "int",
            "default": 40,
            "min": 10,
            "max": 100,
            "control": {
                "slider": true
            }
        },
        "show-only-if-better": {
            "name": "Скрывать когда впереди",
            "description": "Прятать призрака если ты его обогнал",
            "type": "bool",
            "default": false
        },
        "record-practice": {
            "name": "Записывать в практике",
            "description": "Записывать попытки в режиме практики",
            "type": "bool",
            "default": false
        },
        "ghost-color": {
            "name": "Цвет призрака",
            "description": "Цвет отображения призрака",
            "type": "color",
            "default": [100, 200, 255]
        }
    },
    "tags": ["gameplay", "enhancement", "interface"]
}

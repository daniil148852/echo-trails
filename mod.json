// Полные настройки + твои слайдеры/тумблеры
// CLI (geode new) заполнит geode/gd автоматически, но для репо — вот готовый
{
	"geode": "^3.6.0",
	"gd": {
		"android": "3.00",
		"win": "2.207",
		"ios": "2.207",
		"mac": "2.207"
	},
	"_id": "daniiil.echo-trails",
	"name": "Echo Trails",
	"version": "1.0.0",
	"developer": "Даниил",
	"description": "Призрачные полупрозрачные следы за игроком с задержкой. Поддержка радуги!",
	"settings": [
		{
			"name": "enabled",
			"type": "bool",
			"default": true,
			"desc": "Включить эффект Echo Trails"

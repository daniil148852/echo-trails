		{
			"name": "ghost-count",
			"type": "int",
			"default": 5,
			"min": 1,
			"max": 20,
			"name": "Количество призраков",
			"desc": "Сколько копий игрока показывать (1-20)",
			"controls": {
				"slider": true,
				"arrows": true,
				"arrow-step": 1,
				"slider-step": 1
			}
		},
		{
			"name": "frame-delay",
			"type": "int",
			"default": 4,
			"min": 1,
			"max": 10,
			"name": "Задержка кадров",
			"desc": "Задержка между следами в кадрах (1-10)",
			"controls": {
				"slider": true,
				"arrows": true,
				"arrow-step": 1,
				"slider-step": 1
			}
		},
		{
			"name": "base-opacity",
			"type": "int",
			"default": 180,
			"min": 50,
			"max": 255,
			"name": "Базовая прозрачность",
			"desc": "Прозрачность ближайшего следа (50-255)",
			"controls": {
				"slider": true,
				"arrows": true,
				"arrow-step": 5,
				"slider-step": 1
			}
		},
		{
			"name": "use-rainbow",
			"type": "bool",
			"default": false,
			"desc": "Радужные цвета вместо цвета игрока"
		}
	]

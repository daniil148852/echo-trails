{
    "geode": "4.10.2",
    "gd": {
        "android": "2.2074"
    },
    "id": "yourname.echo-trails",
    "name": "Echo Trails",
    "version": "v1.0.0",
    "developer": "YourName",
    "description": "Watch your ghost from the best attempt while playing! Race against yourself.",
    "repository": "https://github.com/yourname/EchoTrails",
    "settings": {
        "enabled": {
            "name": "Enable Ghost",
            "description": "Show ghost replay during gameplay",
            "type": "bool",
            "default": true
        },
        "ghost-opacity": {
            "name": "Ghost Opacity",
            "description": "Transparency of the ghost player",
            "type": "float",
            "default": 0.5,
            "min": 0.1,
            "max": 1.0,
            "control": {
                "slider": true,
                "slider-step": 0.1
            }
        },
        "record-mode": {
            "name": "Record Mode",
            "description": "When to save ghost data",
            "type": "string",
            "default": "best-progress",
            "one-of": ["best-progress", "completion-only", "always"]
        },
        "ghost-color": {
            "name": "Ghost Color",
            "description": "Custom color for the ghost",
            "type": "color",
            "default": [100, 200, 255, 255]
        },
        "show-trail": {
            "name": "Show Ghost Trail",
            "description": "Display trail behind the ghost",
            "type": "bool",
            "default": true
        }
    },
    "resources": {
        "files": [
            "resources/*.png"
        ]
    },
    "tags": ["gameplay", "enhancement", "utility"]
}

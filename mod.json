{
    "geode": "4.10.2",
    "gd": {
        "win": "2.2074",
        "android": "2.2074"
    },
    "id": "yourname.ai-assistant",
    "name": "AI Assistant",
    "version": "v1.0.0",
    "developer": "YourName",
    "description": "AI-powered assistant for Geometry Dash using Groq API.",
    "tags": ["interface", "enhancement"],
    "settings": {
        "api-key": {
            "name": "Groq API Key",
            "description": "Your Groq API key (starts with gsk_)",
            "type": "string",
            "default": ""
        },
        "model": {
            "name": "AI Model",
            "description": "Which AI model to use",
            "type": "string",
            "default": "llama-3.3-70b-versatile",
            "one-of": [
                "llama-3.3-70b-versatile",
                "llama-3.1-8b-instant",
                "mixtral-8x7b-32768",
                "gemma2-9b-it"
            ]
        },
        "auto-tips": {
            "name": "Auto Tips on Death",
            "description": "Automatically show AI tips after multiple deaths",
            "type": "bool",
            "default": true
        },
        "death-threshold": {
            "name": "Deaths Before Tip",
            "description": "Number of deaths at same spot before showing tip",
            "type": "int",
            "default": 3,
            "min": 1,
            "max": 10
        },
        "temperature": {
            "name": "AI Creativity",
            "description": "Higher = more creative responses",
            "type": "float",
            "default": 0.7,
            "min": 0.0,
            "max": 1.5
        },
        "max-tokens": {
            "name": "Max Response Length",
            "description": "Maximum tokens in AI response",
            "type": "int",
            "default": 256,
            "min": 50,
            "max": 1024
        }
    }
}

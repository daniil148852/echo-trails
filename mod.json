{
    "geode": "4.10.2",
    "gd": {
        "android": "2.207",
        "win": "2.207",
        "ios": "2.207",
        "mac": "2.207"
    },
    "id": "daniiil.echo-trails",
    "name": "Echo Trails",
    "version": "v1.0.0",
    "developer": "Daniiil",
    "description": "Призрачные полупрозрачные следы за игроком с задержкой. Поддержка радуги!",
    "repository": "https://github.com/YOUR_USERNAME/echo-trails",
    "settings": {
        "enabled": {
            "name": "Включить Echo Trails",
            "description": "Включить эффект призрачных следов",
            "type": "bool",
            "default": true
        },
        "ghost-count": {
            "name": "Количество призраков",
            "description": "Сколько копий игрока показывать (1-20)",
            "type": "int",
            "default": 5,
            "min": 1,
            "max": 20,
            "control": {
                "slider": true,
                "slider-step": 1,
                "arrows": true,
                "arrow-step": 1
            }
        },
        "frame-delay": {
            "name": "Задержка кадров",
            "description": "Задержка между следами в кадрах (1-10)",
            "type": "int",
            "default": 4,
            "min": 1,
            "max": 10,
            "control": {
                "slider": true,
                "slider-step": 1,
                "arrows": true,
                "arrow-step": 1
            }
        },
        "base-opacity": {
            "name": "Базовая прозрачность",
            "description": "Прозрачность ближайшего следа (50-255)",
            "type": "int",
            "default": 180,
            "min": 50,
            "max": 255,
            "control": {
                "slider": true,
                "slider-step": 5,
                "arrows": true,
                "arrow-step": 5
            }
        },
        "use-rainbow": {
            "name": "Радужные цвета",
            "description": "Радужные цвета вместо цвета игрока",
            "type": "bool",
            "default": false
        }
    }
}
